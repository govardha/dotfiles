#!/bin/bash
set -euo pipefail

# Source your secrets
source "${HOME}/.config/shell/secrets"
USER=$(whoami)

# Parse git credential request
while IFS== read -r key value; do
  case "$key" in
    host) host="$value" ;;
    username) username="$value" ;;
    protocol) protocol="$value" ;;
  esac
done

# Only handle Bitbucket requests
if [[ "$host" == "devtools.miamiholdings.corp" ]]; then
  echo "protocol=${protocol}"
  echo "host=${host}"
  echo "username=${USER}"
  echo "password=${BKT_TOKEN}"
fi
