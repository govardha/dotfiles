# bashrc.common — shared interactive shell config


# Homebrew
if [[ -f "/home/linuxbrew/.linuxbrew/bin/brew" ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

# Neovim
export EDITOR=nvim
alias vi='nvim'
alias vim='nvim'

# PATH
export PATH="${PATH}:${HOME}/.local/bin"
export PATH="${PATH}:${HOME}/bin"

# Aliases
alias gfgp='git fetch && git pull'
alias awslogin='aws sso login --sso-session rinku --no-browser --use-device-code'

rmux() {
    local target="$1" session="$2"
    [[ -z "$target" ]] && { echo "usage: rmux [user@]host [session-name]" >&2; return 1; }

    local host="${target##*@}"          # strip user@ if present
    host="${host//[.:]/-}"              # sanitize for tmux session name (dots/colons break pane addressing)
    session="${session:-$host}"

    ssh -t "$target" "tmux new-session -A -s '$session'"
}

# Bash completions
if [[ -r "/home/linuxbrew/.linuxbrew/etc/profile.d/bash_completion.sh" ]]; then
  source "/home/linuxbrew/.linuxbrew/etc/profile.d/bash_completion.sh"
fi

# Pyenv
export PYENV_ROOT="${HOME}/.pyenv"
[[ -d "${PYENV_ROOT}/bin" ]] && export PATH="${PYENV_ROOT}/bin:${PATH}"
if command -v pyenv &>/dev/null; then
  eval "$(pyenv init - bash)"
fi

# NVM
export NVM_DIR="${HOME}/.nvm"
[[ -s "${NVM_DIR}/nvm.sh" ]] && source "${NVM_DIR}/nvm.sh"
[[ -s "${NVM_DIR}/bash_completion" ]] && source "${NVM_DIR}/bash_completion"

# konf-go (kubeconfig manager: https://github.com/SimonTheLeg/konf-go)
# Binary is `konf-go` (on PATH via ~/.local/bin); the shellwrapper installs a
# `konf` function that sets $KUBECONFIG in the CURRENT shell (no subshell).
if command -v konf-go &>/dev/null; then
  source <(konf-go shellwrapper bash)
  source <(konf-go completion bash) 2>/dev/null || true
  alias kctx='konf set'
fi

# kubeswitch (namespace/context switcher: https://github.com/danielfoehrKn/kubeswitch)
# `switcher` binary on PATH + switch.sh defines the `switch` function (sets
# $KUBECONFIG per-shell). Used mainly for `switch ns` namespace switching;
# coexists with konf-go (konf = cluster, switch ns = namespace).
if command -v switcher &>/dev/null && [[ -f "${HOME}/.local/share/kubeswitch/switch.sh" ]]; then
  source "${HOME}/.local/share/kubeswitch/switch.sh"
  source <(switch completion bash) 2>/dev/null || true
fi

# kubectl shortcut + completion
if command -v kubectl &>/dev/null; then
  alias k='kubectl'
  source <(kubectl completion bash) 2>/dev/null || true
  # make `k` inherit kubectl completion
  complete -o default -F __start_kubectl k 2>/dev/null || true
fi

# AWS completer
if command -v aws_completer &>/dev/null; then
  complete -C "$(command -v aws_completer)" aws
fi

# Kiro CLI env (triggers co-author hook on git commits)
export KIRO_CLI=1

# Secrets (host-local, never committed)
[[ -f "${HOME}/.config/shell/secrets" ]] && source "${HOME}/.config/shell/secrets"
[[ -f "${HOME}/.config/shell/claude-providers.sh" ]] && source "${HOME}/.config/shell/claude-providers.sh"
